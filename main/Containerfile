FROM registry.fedoraproject.org/fedora-toolbox:44 AS emacs_build_deps

RUN dnf -y upgrade && \
    dnf -y install \
	git \
        alsa-lib-devel \
        atk-devel \
        autoconf \
        bzip2 \
        cairo \
        cairo-devel \
        dbus-devel \
        desktop-file-utils \
        fontconfig-devel \
        freetype-devel \
        gcc \
        giflib-devel \
        glibc-devel \
        gnupg2 \
        gnutls-devel \
        gtk3-devel \
        gzip \
        harfbuzz-devel \
        libacl-devel \
        libappstream-glib \
        libgccjit-devel \
        libjpeg-turbo \
        libjpeg-turbo-devel \
        libotf-devel \
        libpng-devel \
        librsvg2-devel \
        libselinux-devel \
        libtiff-devel \
        libtree-sitter-devel \
        libwebp-devel \
        libxml2-devel \
        m17n-lib-devel \
        make \
        ncurses-devel \
        sqlite-devel \
        systemd-devel \
        systemd-rpm-macros \
        texinfo \
        zlib-devel \
    && dnf clean all

FROM emacs_build_deps AS emacs_build

WORKDIR /usr/src
ENV CFLAGS="-O2 -march=native"
RUN git clone --depth 1 https://github.com/emacs-mirror/emacs.git && \
    cd emacs && \
    # these comes from Fedora's `emacs.spec' file for pgtk
    ./autogen.sh && \
    ./configure \
        --disable-gc-mark-trace \
        --with-cairo \
        --with-dbus \
        --with-gif \
        --with-gpm=no \
        --with-harfbuzz \
        --with-jpeg \
        --with-modules \
        --with-native-compilation=aot \
        --with-pgtk \
        --with-png \
        --with-rsvg \
        --with-sqlite3 \
        --with-tiff \
        --with-tree-sitter \
        --with-webp \
        --with-xpm \
        --with-file-notification=inotify && \
    make -j"$(nproc)" && \
    make DESTDIR=/tmp/installroot install && \
    make distclean && \
    mkdir -p /tmp/installroot/usr/src && \
    cp -r /usr/src/emacs /tmp/installroot/usr/src

FROM registry.fedoraproject.org/fedora-toolbox:44 AS emacs_runtime

RUN dnf -y upgrade && \
    dnf -y install \
        gtk3 \
        gnutls \
        ncurses-libs \
        libtree-sitter \
        sqlite-libs \
        libgccjit \
        libjpeg-turbo \
        librsvg2 \
        libwebp \
        libtiff \
        libotf \
        giflib \
        libvterm-devel \
    && dnf clean all

COPY --from=emacs_build /tmp/installroot/ /


FROM emacs_runtime AS emacs_base

RUN dnf -y install \
        flatpak-xdg-open \
        adw-gtk3-theme \
        google-noto-color-emoji-fonts \
        gdk-pixbuf2-modules-extra \
        jetbrains-mono-fonts-all \
    && dnf clean all \
    && ln -sf /usr/bin/podman-remote /usr/bin/podman

FROM emacs_base as lang_toolchains

# LaTeX
RUN dnf -y install \
        texlive-scheme-medium \
        texlive-collection-latex \
        texlive-collection-latexrecommended \
        texlive-collection-latexextra \
        texlive-collection-fontsrecommended \
        texlive-pgf \
        texlive-e-french \
        texlive-collection-langenglish \
        texlive-collection-langfrench \
        texlive-collection-xetex \
        texlive-collection-luatex \
        texlive-apacite \
    && dnf clean all

WORKDIR /tmp
ARG LTEX_LS_PLUS_VERSION="18.7.0"
ARG LTEX_LS_PLUS_URL="https://github.com/ltex-plus/ltex-ls-plus/releases/download/${LTEX_LS_PLUS_VERSION}/ltex-ls-plus-${LTEX_LS_PLUS_VERSION}-linux-x64.tar.gz"
# ltex-ls-plus for grammar checking
RUN curl -o ltex-ls-plus.tar.gz -L ${LTEX_LS_PLUS_URL} \
    && tar -xvf ltex-ls-plus.tar.gz  -C /usr/local --no-same-owner --no-overwrite-dir \
    && ln -s /usr/local/ltex-ls-plus-*/bin/ltex-ls-plus /usr/local/bin/ltex-ls-plus \
    && rm ltex-ls-plus.tar.gz

# Python
RUN dnf -y install python-pip \
    && dnf clean all \
    && pip install --no-cache-dir pyright

# Racket
RUN dnf -y install \
    racket \
    # Needed for raco
    openssl-devel \
    && dnf clean all

RUN yes a | raco pkg install -i racket-langserver

# R
RUN dnf -y install R \
    && dnf clean all

WORKDIR /tmp
ENV ZIG_VERSION=0.16.0
# Zig
RUN curl -LO https://ziglang.org/download/${ZIG_VERSION}/zig-x86_64-linux-${ZIG_VERSION}.tar.xz && \
    tar -xvf zig-x86_64-linux-${ZIG_VERSION}.tar.xz && \
    cp zig-x86_64-linux-${ZIG_VERSION}/zig /usr/bin && \
    cp zig-x86_64-linux-${ZIG_VERSION}/lib -r /usr/ && \
    curl -LO https://builds.zigtools.org/zls-x86_64-linux-${ZIG_VERSION}.tar.xz && \
    tar -xvf zls-x86_64-linux-${ZIG_VERSION}.tar.xz && \
    cp zls /usr/bin

# C/CPP
RUN dnf -y group install development-tools \
    && dnf -y install \
        # Needed for conan...
        perl-core \
        clang-tools-extra \
        cmake \
        meson \
        make \
        g++ \
        gdb \
        bear \
        perf \
    && dnf clean all

FROM lang_toolchains AS misc_tools
RUN dnf -y install \
        pandoc \
        stow \
        wl-clipboard \
        direnv \
        hunspell-en \
        hunspell-fr \
        locate \
        podman-remote \
        hugo \
    && dnf clean all

FROM misc_tools AS finishing_touches
RUN mandb && updatedb
RUN rm -r /tmp/*
